---
import { Rss } from "@lucide/astro";

const id = "add-feed-dialog";
---

<button id="open-dialog" class="btn btn-primary p-1 h-10">
  <Rss class="inline size-4" />
  <span>Add Feed</span>
</button>

<dialog
  id={id}
  class="rounded-xl p-0 backdrop:bg-black/40 open:fixed open:top-1/2 open:left-1/2 -translate-1/2"
>
  <form id="feed-form" class="card w-96 flex flex-col gap-3 justify-around">
    <h2 class="mb-4 text-xl font-semibold w-full">Add Feed</h2>

    <input
      type="text"
      name="title"
      id="feed-title"
      class="input"
      placeholder="Title"
      required
    />

    <input
      id="feed-url"
      class="input"
      name="url"
      type="url"
      placeholder="https://example.com/feed.xml"
      required
    />
    <div>
      <select
        class="input hover:cursor-pointer overflow-y-scroll"
        id="feed-category"
        name="category"
        form="feed-form"
      >
        <option class="" value="uncategorized" selected>Uncategorzied</option>
        <option class="" value="science_and_tech">Science and Technology</option
        >
        <option class="" value="news">News</option>
        <option class="" value="sports">Sports</option>
        <option class="" value="business_and_finance"
          >Business and Finance</option
        >
        <option class="" value="entertainment">Entertainment</option>
        <option class="" value="food">Food</option>
        <option class="" value="health_and_fitness">Health and Fitness</option>
      </select>
    </div>

    <div class="mt-6 flex justify-end gap-2">
      <button type="button" id="cancel-btn" class="btn"> Cancel </button>

      <button type="submit" id="submit-btn" class="btn btn-primary">
        Add
      </button>
    </div>
  </form>
</dialog>

<script>
  import { actions } from "astro:actions";

  const dialog = document.getElementById(
    "add-feed-dialog",
  ) as HTMLDialogElement;
  const openButton = document.getElementById(
    "open-dialog",
  ) as HTMLButtonElement;
  const cancelButton = document.getElementById(
    "cancel-btn",
  ) as HTMLButtonElement;
  const submitButton = document.getElementById(
    "submit-btn",
  ) as HTMLButtonElement;
  const form = document.getElementById("feed-form") as HTMLFormElement;

  let loading = false;

  const toggleLoading = () => {
    if (loading) {
      submitButton.setAttribute("disabled", "");
      cancelButton.setAttribute("disabled", "");
    }
    submitButton.removeAttribute("disabled");
    cancelButton.removeAttribute("disabled");
  };

  openButton?.addEventListener("click", () => {
    dialog?.showModal();
  });

  cancelButton?.addEventListener("click", () => {
    dialog?.close();
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    loading = true;
    toggleLoading();
    const formData = new FormData(form);
    const title = formData.get("title");
    const url = formData.get("url");
    const category = formData.get("category");

    if (typeof title !== "string" || typeof url !== "string") {
      return;
    }

    const result = await actions.addFeed({
      title,
      url,
      category: typeof category === "string" ? category : undefined,
    });

    if (result.error) {
      if (result.error.code == "CONFLICT") {
        alert(result.error.message);
        return;
      }

      alert("Failed to add the feed. Please, try again.");
      console.error("Failed to add feed:", result.error.message);
      return;
    }

    loading = false;
    toggleLoading();
    dialog?.close();

    form.reset();
    location.reload();
  });

  dialog?.addEventListener("close", () => {
    form?.reset();
  });
</script>
