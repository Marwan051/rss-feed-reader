---
import Layout from "../layouts/Layout.astro";
import AddFeedButton from "../components/FeedButtons/AddFeedButton.astro";
import { getFeeds, getAllFeedItems } from "../db/queries/rss-feeds";
import { Sidebar } from "../components/Bars/SideBar";
import { MiddleBar } from "../components/Bars/MiddleBar";
import { FeedViewer } from "../components/FeedViewer";

const feeds = getFeeds();
const initialItems = getAllFeedItems().map((item) => ({
  itemId: item.itemId,
  title: item.title ?? "No title",
  pubDate: new Date(item.pubDate!),
}));
---

<Layout>
  <div class="w-full flex justify-end gap-4 p-3 items-center">
    <AddFeedButton />
    <button class="primary-btn p-4" id="update-feeds-btn"> Update feed </button>
  </div>
  <section
    class="grid grid-cols-[3fr_4fr_6fr] grid-rows-1 flex-1 min-h-0 w-full"
  >
    <!-- Feed/Category chooser -->
    <section class="h-full bg-amber-500" id="side-bar">
      <Sidebar initialFeeds={feeds} client:load />
    </section>

    <!-- Feed item chooser -->
    <section class="h-full bg-blue-700">
      <MiddleBar initialItems={initialItems} client:load />
    </section>

    <!-- Feed item viewer -->
    <section class="h-full bg-emerald-500">
      <FeedViewer client:load />
    </section>
  </section>
</Layout>
<script>
  import { actions } from "astro:actions";

  const updateFeedsButton = document.getElementById(
    "update-feeds-btn",
  ) as HTMLButtonElement;

  updateFeedsButton?.addEventListener("click", async () => {
    await actions.updateAllFeedItems();
  });

  document.addEventListener("feed-selected", (event) => {});
</script>
