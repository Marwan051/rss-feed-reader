---
import { X } from "@lucide/astro";

interface Props {
  feedID: number;
  feedTitle: string;
  feedUrl: string;
  feedCategory: string;
}
const { feedID, feedTitle, feedUrl, feedCategory } = Astro.props;
---

<div
  class="grid w-full grid-cols-[minmax(0,3fr)_minmax(0,5fr)_minmax(0,1fr)_auto] items-center gap-4"
>
  <span class="min-w-0 truncate">{feedTitle}</span>
  <span class="min-w-0 truncate">{feedUrl}</span>
  <span class="min-w-0 truncate">{feedCategory}</span>
  <button
    class="justify-self-end rounded border border-black bg-red-500 p-4 font-extrabold hover:cursor-pointer hover:bg-red-700 transition-colors duration-300"
    data-feed-id={feedID}
  >
    <X />
  </button>
</div>
